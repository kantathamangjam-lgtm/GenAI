import os
from pypdf import PdfReader
from openai import OpenAI  # Or use google.generativeai
from google.colab import userdata

# Initialize the client (ensure OPENAI_API_KEY is set in your environment)
client = OpenAI(api_key=userdata.get("OPENAI_API_KEY"))

def extract_text_from_pdf(pdf_path):
  reader = PdfReader(pdf_path)
  text = ""
  for page in reader.pages:
    text += page.extract_text() or ""
  return text

def generate_questions(text_content):
  prompt = f"Based on the following text, generate 5 multiple-choice questions with answers:\n\n{text_content[:4000]}"

  response = client.chat.completions.create(
      model="gpt-4o-mini",
      messages=[
          {
              "role": "user",
              "content": prompt,
          }
      ],
  )
  return response.choices.message.content

# Usage
pdf_text = extract_text_from_pdf("/sample.pdf")
quiz = generate_questions(pdf_text)
print(quiz)
